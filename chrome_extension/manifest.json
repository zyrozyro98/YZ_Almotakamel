{
  "manifest_version": 3,
  "name": "أتمتة الدخول - لوحة الحل",
  "version": "1.0",
  "description": "إضافة لموظفي النظام لتسجيل الدخول التلقائي في المنصات التعليمية بدون عرض بيانات الدخول.",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
